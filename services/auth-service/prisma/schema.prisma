generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String      @id @default(uuid())
  email           String?     @unique
  phone           String?     @unique
  status          String      @default("ACTIVE") // ACTIVE, SUSPENDED, DISABLED, PENDING
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  lastLoginAt     DateTime?

  roles           UserRole[]
  credentials     Credential?
}

model Credential {
  id                String   @id @default(uuid())
  userId            String   @unique
  passwordHash      String
  passwordChangedAt DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id          String      @id @default(uuid())
  name        String      @unique // SUPER_ADMIN, MERCHANT_OWNER, etc.
  description String?
  createdAt   DateTime    @default(now())
  users       UserRole[]
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  merchantId String?  // Null if system-wide admin, otherwise scoped to a merchant (Logical reference to merchant_db)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, merchantId])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorType    String   // USER, SYSTEM
  actorId      String?  
  action       String
  resourceType String
  resourceId   String?
  beforeData   Json?
  afterData    Json?
  reason       String?
  ipAddress    String?
  traceId      String?
  createdAt    DateTime @default(now())
}

model ProcessedEvent {
  eventId     String   @id // The original event ID to ensure idempotency
  processedAt DateTime @default(now())
}
