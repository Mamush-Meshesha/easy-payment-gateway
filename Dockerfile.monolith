# Stage 1: Build Go Services
FROM golang:1.25 AS go-builder
WORKDIR /app

# Copy all Go workspaces
COPY proto/ /app/proto/
COPY packages/ /app/packages/
COPY services/ /app/services/

# Build each critical Go service
RUN cd /app/services/payment-service && CGO_ENABLED=0 go build -o /app/bin/payment-service ./cmd/server
RUN cd /app/services/ledger-service && CGO_ENABLED=0 go build -o /app/bin/ledger-service ./cmd/server
RUN cd /app/services/transaction-service && CGO_ENABLED=0 go build -o /app/bin/transaction-service ./cmd/server
RUN cd /app/services/provider-service && CGO_ENABLED=0 go build -o /app/bin/provider-service ./cmd/server
RUN cd /app/services/webhook-service && CGO_ENABLED=0 go build -o /app/bin/webhook-service ./cmd/server
RUN cd /app/services/settlement-service && CGO_ENABLED=0 go build -o /app/bin/settlement-service ./cmd/server
RUN cd /app/services/risk-service && CGO_ENABLED=0 go build -o /app/bin/risk-service ./cmd/server
RUN cd /app/services/reconciliation-service && CGO_ENABLED=0 go build -o /app/bin/reconciliation-service ./cmd/server
RUN cd /app/services/dispute-service && CGO_ENABLED=0 go build -o /app/bin/dispute-service ./cmd/server
RUN cd /app/services/billing-service && CGO_ENABLED=0 go build -o /app/bin/billing-service ./cmd/server
# Stage 2: Build Node.js Services (Dashboard)
FROM node:20-alpine AS node-builder
RUN apk add --no-cache protoc protobuf-dev
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/ /app/packages/
COPY services/dashboard-service/ /app/services/dashboard-service/
COPY services/auth-service/ /app/services/auth-service/
COPY services/merchant-service/ /app/services/merchant-service/
COPY services/admin-service/ /app/services/admin-service/
COPY services/reporting-service/ /app/services/reporting-service/
RUN npm install
RUN npm run build --workspaces --if-present
RUN npm run build -w dashboard-service || true
RUN npm run build -w auth-service || true
RUN npm run build -w merchant-service || true
RUN npm run build -w admin-service || true
RUN npm run build -w reporting-service || true

# Stage 3: Final Image
FROM node:20-alpine
WORKDIR /app

# Install Nginx, Supervisord, and Redis
RUN apk add --no-cache nginx supervisor tzdata ca-certificates redis

# Copy Go binaries
COPY --from=go-builder /app/bin/* /app/bin/

# Copy Node.js built app
COPY --from=node-builder /app/services/dashboard-service /app/services/dashboard-service
COPY --from=node-builder /app/services/auth-service /app/services/auth-service
COPY --from=node-builder /app/services/merchant-service /app/services/merchant-service
COPY --from=node-builder /app/services/admin-service /app/services/admin-service
COPY --from=node-builder /app/services/reporting-service /app/services/reporting-service
COPY --from=node-builder /app/packages /app/packages
COPY --from=node-builder /app/node_modules /app/node_modules

# Copy mTLS certificates
COPY infra/certs /app/certs

# Nginx config
COPY nginx.monolith.conf /etc/nginx/nginx.conf

# Supervisord config
COPY supervisord.conf /etc/supervisord.conf

# Expose single public port
EXPOSE 8080

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]
