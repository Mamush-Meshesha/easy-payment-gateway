# Stage 1: Build Go Services
FROM golang:1.25 AS go-builder
WORKDIR /app

# Copy all Go workspaces
COPY proto/ /app/proto/
COPY packages/ /app/packages/
COPY services/ /app/services/

# Build each critical Go service
RUN cd /app/services/payment-service && CGO_ENABLED=0 go build -o /app/bin/payment-service ./cmd/server
RUN cd /app/services/ledger-service && CGO_ENABLED=0 go build -o /app/bin/ledger-service ./cmd/server
RUN cd /app/services/transaction-service && CGO_ENABLED=0 go build -o /app/bin/transaction-service ./cmd/server
RUN cd /app/services/provider-service && CGO_ENABLED=0 go build -o /app/bin/provider-service ./cmd/server
RUN cd /app/services/webhook-service && CGO_ENABLED=0 go build -o /app/bin/webhook-service ./cmd/server

# Stage 2: Build Node.js Services (Dashboard)
FROM node:20-alpine AS node-builder
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/ /app/packages/
COPY services/dashboard-service/ /app/services/dashboard-service/
COPY services/auth-service/ /app/services/auth-service/
COPY services/merchant-service/ /app/services/merchant-service/
RUN npm install
RUN npm run build -w dashboard-service
RUN npm run build -w auth-service
RUN npm run build -w merchant-service

# Stage 3: Final Image
FROM node:20-alpine
WORKDIR /app

# Install Nginx and Supervisord
RUN apk add --no-cache nginx supervisor tzdata ca-certificates

# Copy Go binaries
COPY --from=go-builder /app/bin/* /app/bin/

# Copy Node.js built app
COPY --from=node-builder /app/services/dashboard-service /app/services/dashboard-service
COPY --from=node-builder /app/services/auth-service /app/services/auth-service
COPY --from=node-builder /app/services/merchant-service /app/services/merchant-service
COPY --from=node-builder /app/packages /app/packages
COPY --from=node-builder /app/node_modules /app/node_modules

# Nginx config
COPY nginx.monolith.conf /etc/nginx/nginx.conf

# Supervisord config
COPY supervisord.conf /etc/supervisord.conf

# Expose single public port
EXPOSE 8080

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]
