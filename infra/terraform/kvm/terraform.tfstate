            "rendered": "#cloud-config\npreserve_hostname: false\nhostname: payment-gateway-lab\nfqdn: payment-gateway-lab.local\n\nusers:\n  - name: mamush\n    groups: sudo, docker\n    shell: /bin/bash\n    sudo: ['ALL=(ALL) NOPASSWD:ALL']\n    ssh_authorized_keys:\n      # This will be injected by Terraform from the variable\n      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIC3GE7fJRLxdI0PB/JCG/rgAS1IPFgYJf79Tjs060MNI payment-gateway-terraform\n\n\npackage_update: true\npackage_upgrade: true\n\npackages:\n  - apt-transport-https\n  - ca-certificates\n  - curl\n  - gnupg\n  - lsb-release\n  - qemu-guest-agent\n  - make\n\nruncmd:\n  # Install Docker using the official script\n  - curl -fsSL https://get.docker.com -o get-docker.sh\n  - sh get-docker.sh\n  \n  # Ensure the user has docker permissions\n  - usermod -aG docker mamush\n  \n  # Start and enable QEMU guest agent (allows Terraform to get IP address)\n  - systemctl start qemu-guest-agent\n  - systemctl enable qemu-guest-agent\n  \n  # Ensure Docker is running\n  - systemctl start docker\n  - systemctl enable docker\n",
            "template": "#cloud-config\npreserve_hostname: false\nhostname: payment-gateway-lab\nfqdn: payment-gateway-lab.local\n\nusers:\n  - name: mamush\n    groups: sudo, docker\n    shell: /bin/bash\n    sudo: ['ALL=(ALL) NOPASSWD:ALL']\n    ssh_authorized_keys:\n      # This will be injected by Terraform from the variable\n      - ${ssh_public_key}\n\npackage_update: true\npackage_upgrade: true\n\npackages:\n  - apt-transport-https\n  - ca-certificates\n  - curl\n  - gnupg\n  - lsb-release\n  - qemu-guest-agent\n  - make\n\nruncmd:\n  # Install Docker using the official script\n  - curl -fsSL https://get.docker.com -o get-docker.sh\n  - sh get-docker.sh\n  \n  # Ensure the user has docker permissions\n  - usermod -aG docker mamush\n  \n  # Start and enable QEMU guest agent (allows Terraform to get IP address)\n  - systemctl start qemu-guest-agent\n  - systemctl enable qemu-guest-agent\n  \n  # Ensure Docker is running\n  - systemctl start docker\n  - systemctl enable docker\n",
