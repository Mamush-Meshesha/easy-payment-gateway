# Infrastructure Connections
DATABASE_URL=postgresql://postgres:postgres@payment_postgres:5432/payment_gateway?sslmode=disable
REDIS_URL=redis://payment_redis:6379
KAFKA_BROKERS=payment_kafka:9092

# Services
LEDGER_SERVICE_ADDR=payment-gateway-ledger-service-1:50053
MERCHANT_SERVICE_ADDR=payment-gateway-merchant-service-1:50052
RISK_SERVICE_ADDR=payment-gateway-risk-service-1:50054
PROVIDER_SERVICE_ADDR=payment-gateway-provider-service-1:50055
AUTH_SERVICE_HOST=payment-gateway-auth-service-1
AUTH_GRPC_PORT=50051

# Certs (Internal Docker paths)
MTLS_CA_CERT=/app/certs/ca.crt
MTLS_SERVER_CERT=/app/certs/server.crt
MTLS_SERVER_KEY=/app/certs/server.key

# App config
JWT_SECRET=super-secret-jwt-key
NODE_ENV=development
