# -------------------------------------
# Payment Gateway Master Environment File
# -------------------------------------

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=payment_gateway
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/payment_gateway?schema=public

# Caching & Event Bus
REDIS_URL=redis://redis:6379
KAFKA_BROKERS=kafka:9092

# Secrets (Do NOT put production secrets here, use AWS Secrets Manager in prod)
JWT_SECRET=super_secret_dev_key_12345
API_SECRET=super_secret_internal_key

# External Providers (Mocked for local dev)
TELEBIRR_API_URL=http://localhost:9999/telebirr
MPESA_API_URL=http://localhost:9999/mpesa
